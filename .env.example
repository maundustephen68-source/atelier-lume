# --- Database ---
# Local dev (SQLite, zero config):
DATABASE_URL="file:./dev.db"
# Production (Postgres) - after switching prisma/schema.prisma provider to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Site ---
SITE_URL="http://localhost:3000"

# --- Auth ---
SESSION_SECRET="replace-with-a-long-random-string"
SEED_ADMIN_EMAIL="owner@atelierlume.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CURRENCY="usd"
DEPOSIT_PERCENT="100"

# --- Email (Resend - https://resend.com) ---
RESEND_API_KEY="re_..."
FROM_EMAIL="bookings@yourdomain.com"
OWNER_EMAIL="owner@yourdomain.com"

# --- WhatsApp (Twilio WhatsApp Business API) ---
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
OWNER_WHATSAPP_NUMBER="+2547........."
# Meta-approved Content Template SIDs (create these in Twilio Content API / Meta Business Manager)
TWILIO_TEMPLATE_CONFIRM_CLIENT="HX..."
TWILIO_TEMPLATE_CONFIRM_OWNER="HX..."
TWILIO_TEMPLATE_REMINDER_24H="HX..."
TWILIO_TEMPLATE_REMINDER_1H="HX..."
TWILIO_TEMPLATE_REMINDER_24H_OWNER="HX..."

# --- Cron ---
# Any long random string - sent as a Bearer token by Vercel Cron / your scheduler.
CRON_SECRET="replace-with-a-long-random-string"

# --- Booking rules ---
WORKING_HOURS_START="09:00"
WORKING_HOURS_END="18:00"
BOOKING_BUFFER_MINUTES="30"
BOOKING_HOLD_MINUTES="10"
RESCHEDULE_CUTOFF_HOURS="48"

# --- Analytics (pick one, optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="yourdomain.com"
# NEXT_PUBLIC_GA_ID="G-XXXXXXX"
